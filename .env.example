# Claude API (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=

# Which backend run_sql uses: databricks | duckdb
SQL_BACKEND=databricks

# Databricks SQL warehouse (Option A — same tables Genie queries)
# Use a token scoped to read-only access on workspace.whoop_data.
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# Local DuckDB file (Option B — not built yet)
DUCKDB_PATH=data/whoop.duckdb
